-- ฟังก์ชันเพิ่มข้อความในช่องแชท
local function addMessage(sender, text)
	local msgLabel = Instance.new("TextLabel")
	msgLabel.Size = UDim2.new(1, 0, 0, 0)
	msgLabel.AutomaticSize = Enum.AutomaticSize.Y
	msgLabel.BackgroundColor3 = Color3.fromRGB(10, 85, 170)
	msgLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	msgLabel.Text = sender .. ": " .. text
	msgLabel.TextSize = 14
	msgLabel.TextWrapped = true
	msgLabel.TextXAlignment = Enum.TextXAlignment.Left
	msgLabel.Parent = chatLog

	local msgCorner = Instance.new("UICorner")
	msgCorner.CornerRadius = UDim.new(0, 6)
	msgCorner.Parent = msgLabel
	
	local msgPadding = Instance.new("UIPadding")
	msgPadding.PaddingTop = UDim.new(0, 6)
	msgPadding.PaddingBottom = UDim.new(0, 6)
	msgPadding.PaddingLeft = UDim.new(0, 8)
	msgPadding.PaddingRight = UDim.new(0, 8)
	msgPadding.Parent = msgLabel
	
	chatLog.CanvasPosition = Vector2.new(0, chatLog.AbsoluteCanvasSize.Y)
end

-- 7. ระบบตอบคำถามจำลองของ AI (ตอบได้จริงตามคีย์เวิร์ด)
local function getAIResponse(msg)
	msg = string.lower(msg)
	if string.find(msg, "หวัดดี") or string.find(msg, "สวัสดี") or string.find(msg, "hi") or string.find(msg, "hello") then
		return "สวัสดีครับ! ผมคือลีโอ มีอะไรให้ช่วยไหมครับ?"
	elseif string.find(msg, "ชื่ออะไร") then
		return "ผมชื่อ AI ลีโอ ครับ!"
	elseif string.find(msg, "ทำอะไรได้") then
		return "ผมสามารถตอบคำถามทั่วไป คุยเล่น หรือช่วยแนะนำข้อมูลในเกมได้ครับ"
	elseif string.find(msg, "สบายดีไหม") then
		return "สบายดีครับ! พร้อมช่วยคุณเสมอ"
	else
		return "รับทราบครับ! คำถามนี้น่าสนใจมาก มีอะไรสอบถามเพิ่มเติมไหมครับ?"
	end
end

local function onSend()
	local text = textBox.Text
	if text ~= "" then
		addMessage("คุณ", text)
		textBox.Text = ""
		
		task.wait(0.5) -- จำลองระยะเวลาคิดของ AI
		local response = getAIResponse(text)
		addMessage("ลีโอ", response)
	end
end

sendBtn.MouseButton1Click:Connect(onSend)
textBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		onSend()
	end
end)

